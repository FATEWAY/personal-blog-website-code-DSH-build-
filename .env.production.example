# fateway.cn production environment
# Copy this file to `.env.production` on the server and adjust values.
# Never commit the real `.env.production` file.

NODE_ENV=production

# Public origin used by canonical URLs, Open Graph, sitemap and RSS.
SITE_URL=https://fateway.cn

SITE_NAME=fateway

# Requires `npm run build` again when changed in production.
ADMIN_PATH=/admin

DATABASE_PATH=./data/fateway.db
UPLOAD_DIR=./storage/uploads

SESSION_COOKIE_NAME=fw_session
SESSION_TTL_HOURS=168

MAX_UPLOAD_MB=5

# Set to true only behind a trusted reverse proxy that overwrites
# X-Forwarded-For (the Nginx config in deploy/ does this).
TRUST_PROXY=true
