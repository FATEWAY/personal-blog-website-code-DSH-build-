# ---------------------------------------------------------------------------
# fateway.cn — environment configuration
# Copy this file to `.env.local` for local development and adjust the values.
# Never commit real secrets. `.env.local` is ignored by git.
# ---------------------------------------------------------------------------

# Public origin used for canonical links, sitemap and Open Graph metadata.
# Local development: http://localhost:3000
# Production example: https://fateway.cn
SITE_URL=http://localhost:3000

# Display name used as metadata fallback (the site name itself lives in the DB
# settings and is editable in the admin panel).
SITE_NAME=fateway

# Path of the admin panel. Requires a rebuild when changed in production.
# Examples: /admin, /console, /workspace
ADMIN_PATH=/admin

# SQLite database file, relative to the project root (or absolute).
DATABASE_PATH=./data/fateway.db

# Uploaded media directory. Kept outside `public/` and served via /media.
UPLOAD_DIR=./storage/uploads

# Session settings
SESSION_COOKIE_NAME=fw_session
SESSION_TTL_HOURS=168

# Upload limit in megabytes (1–20)
MAX_UPLOAD_MB=5

# Set to true only when the app runs behind a trusted reverse proxy (nginx,
# Caddy) that overwrites X-Forwarded-For. Otherwise rate limiting would trust
# a spoofable header.
TRUST_PROXY=false

# Timezone note: dates are displayed in Asia/Shanghai (UTC+8) by design.

# ---------------------------------------------------------------------------
# One-time administrator bootstrap (used only by `npm run admin:create`).
# Prefer the interactive prompt; these are for automated/CI setups.
# Do not put a real password in this example file.
# ---------------------------------------------------------------------------
# ADMIN_INIT_USERNAME=user
# ADMIN_INIT_PASSWORD=
