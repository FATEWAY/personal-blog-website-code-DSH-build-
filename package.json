{
  "name": "fateway-blog",
  "version": "1.0.0",
  "private": true,
  "description": "fateway.cn — personal technical blog and content management system",
  "scripts": {
    "dev": "next dev",
    "predev": "tsx scripts/db-migrate.ts",
    "build": "next build",
    "start": "next start",
    "prestart": "tsx scripts/db-migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "verify:e2e": "node e2e/verify.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "better-sqlite3": "^13.0.3",
    "github-slugger": "^2.0.0",
    "hast-util-sanitize": "^5.0.2",
    "next": "^15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
